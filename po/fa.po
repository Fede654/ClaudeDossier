msgstr "گشودن مسیر پایهٔ پرونده"

#: data/org.gnome.gitlab.somas.Apostrophe.gschema.xml:65
msgid "Open file paths of the current session"
msgstr "گشودن مسیرهای پروندهٔ نشست کنونی"

