#: data/org.gnome.gitlab.somas.Apostrophe.metainfo.xml.in.in:18
msgid "A distraction-free mode"
msgstr "Sendistra reĝimo"

#: data/org.gnome.gitlab.somas.Apostrophe.metainfo.xml.in.in:19
