msgid "Open file base path"
msgstr "פתיחת נתיב בסיס קבצים"

#: data/org.gnome.gitlab.somas.Apostrophe.gschema.xml:71
msgid "Open file paths of the current session"
msgstr "לפתוח את נתיבי קובצי ההפעלה הנוכחית"

