<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="ApostrophePreferencesDialog" parent="AdwPreferencesDialog">
    <child>
      <object class="AdwPreferencesPage">
        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="enable_claude_row">
                <property name="title" translatable="yes">Claude Scanner</property>
                <property name="subtitle" translatable="yes">Load local Claude Desktop sessions</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="enable_codex_row">
                <property name="title" translatable="yes">Codex Scanner</property>
                <property name="subtitle" translatable="yes">Load Codex CLI sessions</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="enable_antigravity_row">
                <property name="title" translatable="yes">Anti-Gravity Scanner</property>
                <property name="subtitle" translatable="yes">Load Anti-Gravity (Gemini) sessions</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Chat Behavior</property>
            <child>
              <object class="AdwSwitchRow" id="show_progress_row">
                <property name="title" translatable="yes">Show progress events</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="wrap_lines_row">
                <property name="title" translatable="yes">Wrap long lines</property>
                <property name="subtitle" translatable="yes">Fold lines exceeding 120 characters</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="compress_blocks_row">
                <property name="title" translatable="yes">Compress large blocks</property>
                <property name="subtitle" translatable="yes">Collapse messages over 12 lines</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="scroll_bottom_row">
                <property name="title" translatable="yes">Scroll to bottom on open</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
