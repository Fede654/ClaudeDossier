<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.fede.ClaudeDossier" path="/io/fede/ClaudeDossier/">
    <key name="scan-root" type="s">
      <default>''</default>
      <summary>Root directory to scan for Claude sessions (empty = home dir)</summary>
    </key>
    <key name="compact-paths" type="b">
      <default>true</default>
      <summary>Collapse single-child path segments in sidebar</summary>
    </key>
    <key name="cache-size" type="i">
      <default>5</default>
      <summary>Number of parsed sessions to keep in LRU cache</summary>
    </key>
    <key name="terminal-command" type="s">
      <default>''</default>
      <summary>Custom terminal command (empty = auto-detect)</summary>
    </key>
    <key name="experimental-ancestor-claude-dir" type="b">
      <default>false</default>
      <summary>Include .claude/CLAUDE.md from ancestor directories</summary>
    </key>
    <key name="enable-claude" type="b">
      <default>true</default>
      <summary>Enable scanning Claude sessions</summary>
    </key>
    <key name="enable-codex" type="b">
      <default>true</default>
      <summary>Enable scanning Codex sessions</summary>
    </key>
    <key name="enable-antigravity" type="b">
      <default>true</default>
      <summary>Enable scanning Anti-Gravity sessions</summary>
    </key>
    <key name="show-progress" type="b">
      <default>false</default>
      <summary>Show underlying tool/thinking progress events in chat</summary>
    </key>
    <key name="wrap-lines" type="b">
      <default>true</default>
      <summary>Fold very long lines automatically</summary>
    </key>
    <key name="compress-blocks" type="b">
      <default>true</default>
      <summary>Collapse code blocks exceeding 12 lines</summary>
    </key>
    <key name="scroll-bottom" type="b">
      <default>true</default>
      <summary>Automatically scroll to the bottom of the chat when opening</summary>
    </key>
  </schema>
</schemalist>
